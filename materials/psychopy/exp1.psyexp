        <Param name="Begin JS Routine" updates="constant" val="ocena = new visual.TextBox2(win, {&quot;text&quot;: &quot;&quot;, &quot;font&quot;: &quot;Open Sans&quot;, &quot;pos&quot;: [0, (- 0.5)], &quot;letterHeight&quot;: 0.05, &quot;size&quot;: [0.1, 0.1], &quot;borderWidth&quot;: 2.0, &quot;color&quot;: &quot;black&quot;, &quot;colorSpace&quot;: &quot;rgb&quot;, &quot;opacity&quot;: null, &quot;bold&quot;: false, &quot;italic&quot;: false, &quot;lineSpacing&quot;: 1.0, &quot;padding&quot;: null, &quot;anchor&quot;: &quot;center&quot;, &quot;fillColor&quot;: null, &quot;borderColor&quot;: &quot;black&quot;, &quot;flipHoriz&quot;: false, &quot;flipVert&quot;: false, &quot;editable&quot;: true, &quot;name&quot;: &quot;textbox_t&quot;, &quot;autoLog&quot;: true});&amp;#10;" valType="extendedCode"/>
        <Param name="Begin Routine" updates="constant" val="ocena = visual.TextBox2(&amp;#10;     win, text='', font='Open Sans',&amp;#10;     pos=(0, -0.5),     letterHeight=0.05,&amp;#10;     size=(0.1, 0.1), borderWidth=2.0,&amp;#10;     color='black', colorSpace='rgb',&amp;#10;     opacity=None,&amp;#10;     bold=False, italic=False,&amp;#10;     lineSpacing=1.0,&amp;#10;     padding=None,&amp;#10;     anchor='center',&amp;#10;     fillColor=None, borderColor='black',&amp;#10;     flipHoriz=False, flipVert=False,&amp;#10;     editable=True,&amp;#10;     name='textbox_t',&amp;#10;     autoLog=True,&amp;#10;)" valType="extendedCode"/>
