        <Param name="units" updates="None" val="from exp settings" valType="str"/>
        <Param name="wrapWidth" updates="constant" val="" valType="num"/>
      </TextComponent>
    </Routine>
    <Routine name="trial">
      <CodeComponent name="code_trial">
        <Param name="Before Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="Before JS Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="Begin Experiment" updates="constant" val="import numpy as np&amp;#10;import time&amp;#10;&amp;#10;def get_time():&amp;#10;    return time.strftime('%Y-%m-%d_%H-%M-%S', time.localtime())&amp;#10;&amp;#10;acc = 0&amp;#10;k = 0&amp;#10;&amp;#10;#rozwiazywalne tribony&amp;#10;triR = np.array([['r01',&quot;modelka&quot;,&quot;wygląd&quot;,&quot;magazyn&quot;], ['r02',&quot;energia&quot;,&quot;witaminy&quot;,&quot;forma&quot;], ['r03',&quot;graba&quot;,&quot;piątka&quot;,&quot;szufla&quot;], ['r04',&quot;korona&quot;,&quot;sakiewka&quot;,&quot;euro&quot;], ['r05',&quot;zakaz&quot;,&quot;mandat&quot;,&quot;kąt&quot;], ['r06',&quot;zapach&quot;,&quot;śmieci&quot;,&quot;toaleta&quot;], ['r07',&quot;wyrok&quot;,&quot;ściana&quot;,&quot;kat&quot;], ['r08',&quot;woda&quot;,&quot;płuca&quot;,&quot;kamień&quot;], ['r09',&quot;pająk&quot;,&quot;renta&quot;,&quot;czarny&quot;], ['r10',&quot;klasa&quot;,&quot;kościół&quot;,&quot;park&quot;], ['r11',&quot;wózek&quot;,&quot;maszyna&quot;,&quot;fura&quot;], ['r12',&quot;lizak&quot;,&quot;rana&quot;,&quot;znaczek&quot;], ['r13',&quot;jonowy&quot;,&quot;elektronowy&quot;,&quot;optyczny&quot;], ['r14',&quot;golibroda&quot;,&quot;włosie&quot;, &quot;malarz&quot;], ['r15',&quot;okulary&quot;,&quot;flaming&quot;,&quot;wypieki&quot;]])&amp;#10;np.random.shuffle(triR)&amp;#10;&amp;#10;#nierozwiazywalne tribondy&amp;#10;triNR = np.array([['n01',&quot;Buszmen&quot;,&quot;powieka&quot;,&quot;bitwa&quot;], ['n02',&quot;kubizm&quot;,&quot;polana&quot;,&quot;student&quot;], ['n03',&quot;chłodnik&quot;,&quot;dwójka&quot;,&quot;hieroglify&quot;], ['n04',&quot;owoc&quot;,&quot;wydmy&quot;,&quot;obrane&quot;], ['n05',&quot;turecka&quot;,&quot;igłowa&quot;,&quot;masło&quot;], ['n06',&quot;cyrylica&quot;,&quot;kiszka&quot;,&quot;zamkowy&quot;], ['n07',&quot;toaleta&quot;,&quot;żagle&quot;,&quot;arlekin&quot;], ['n08',&quot;uczeń&quot;,&quot;naród&quot;,&quot;łódź&quot;], ['n09',&quot;suma&quot;,&quot;pomidor&quot;,&quot;skrzynia&quot;], ['n10',&quot;cześć&quot;,&quot;szczotka&quot;,&quot;Kalahari&quot;], ['n11',&quot;dolar&quot;,&quot;jamnik&quot;,&quot;surrealizm&quot;], ['n12',&quot;drukarka&quot;,&quot;zagadka&quot;,&quot;mleko&quot;], ['n13',&quot;łyżka&quot;,&quot;rzymska&quot;,&quot;punktowy&quot;], ['n14',&quot;krowa&quot;,&quot;syrop&quot;,&quot;gapa&quot;], ['n15',&quot;krypton&quot;,&quot;klaun&quot;,&quot;skoki&quot;]])&amp;#10;np.random.shuffle(triNR)&amp;#10;" valType="extendedCode"/>
        <Param name="Begin JS Experiment" updates="constant" val="import * as np from 'numpy';&amp;#10;import * as time from 'time';&amp;#10;var acc, k, triNR, triR;&amp;#10;function get_time() {&amp;#10;    return time.strftime(&quot;%Y-%m-%d_%H-%M-%S&quot;, time.localtime());&amp;#10;}&amp;#10;acc = 0;&amp;#10;k = 0;&amp;#10;triR = np.array([[&quot;r01&quot;, &quot;modelka&quot;, &quot;wygl\u0105d&quot;, &quot;magazyn&quot;], [&quot;r02&quot;, &quot;energia&quot;, &quot;witaminy&quot;, &quot;forma&quot;], [&quot;r03&quot;, &quot;graba&quot;, &quot;pi\u0105tka&quot;, &quot;szufla&quot;], [&quot;r04&quot;, &quot;korona&quot;, &quot;sakiewka&quot;, &quot;euro&quot;], [&quot;r05&quot;, &quot;zakaz&quot;, &quot;mandat&quot;, &quot;k\u0105t&quot;], [&quot;r06&quot;, &quot;zapach&quot;, &quot;\u015bmieci&quot;, &quot;toaleta&quot;], [&quot;r07&quot;, &quot;wyrok&quot;, &quot;\u015bciana&quot;, &quot;kat&quot;], [&quot;r08&quot;, &quot;woda&quot;, &quot;p\u0142uca&quot;, &quot;kamie\u0144&quot;], [&quot;r09&quot;, &quot;paj\u0105k&quot;, &quot;renta&quot;, &quot;czarny&quot;], [&quot;r10&quot;, &quot;klasa&quot;, &quot;ko\u015bci\u00f3\u0142&quot;, &quot;park&quot;], [&quot;r11&quot;, &quot;w\u00f3zek&quot;, &quot;maszyna&quot;, &quot;fura&quot;], [&quot;r12&quot;, &quot;lizak&quot;, &quot;rana&quot;, &quot;znaczek&quot;], [&quot;r13&quot;, &quot;jonowy&quot;, &quot;elektronowy&quot;, &quot;optyczny&quot;], [&quot;r14&quot;, &quot;golibroda&quot;, &quot;w\u0142osie&quot;, &quot;malarz&quot;], [&quot;r15&quot;, &quot;okulary&quot;, &quot;flaming&quot;, &quot;wypieki&quot;]]);&amp;#10;np.random.shuffle(triR);&amp;#10;triNR = np.array([[&quot;n01&quot;, &quot;Buszmen&quot;, &quot;powieka&quot;, &quot;bitwa&quot;], [&quot;n02&quot;, &quot;kubizm&quot;, &quot;polana&quot;, &quot;student&quot;], [&quot;n03&quot;, &quot;ch\u0142odnik&quot;, &quot;dw\u00f3jka&quot;, &quot;hieroglify&quot;], [&quot;n04&quot;, &quot;owoc&quot;, &quot;wydmy&quot;, &quot;obrane&quot;], [&quot;n05&quot;, &quot;turecka&quot;, &quot;ig\u0142owa&quot;, &quot;mas\u0142o&quot;], [&quot;n06&quot;, &quot;cyrylica&quot;, &quot;kiszka&quot;, &quot;zamkowy&quot;], [&quot;n07&quot;, &quot;toaleta&quot;, &quot;\u017cagle&quot;, &quot;arlekin&quot;], [&quot;n08&quot;, &quot;ucze\u0144&quot;, &quot;nar\u00f3d&quot;, &quot;\u0142\u00f3d\u017a&quot;], [&quot;n09&quot;, &quot;suma&quot;, &quot;pomidor&quot;, &quot;skrzynia&quot;], [&quot;n10&quot;, &quot;cze\u015b\u0107&quot;, &quot;szczotka&quot;, &quot;Kalahari&quot;], [&quot;n11&quot;, &quot;dolar&quot;, &quot;jamnik&quot;, &quot;surrealizm&quot;], [&quot;n12&quot;, &quot;drukarka&quot;, &quot;zagadka&quot;, &quot;mleko&quot;], [&quot;n13&quot;, &quot;\u0142y\u017cka&quot;, &quot;rzymska&quot;, &quot;punktowy&quot;], [&quot;n14&quot;, &quot;krowa&quot;, &quot;syrop&quot;, &quot;gapa&quot;], [&quot;n15&quot;, &quot;krypton&quot;, &quot;klaun&quot;, &quot;skoki&quot;]]);&amp;#10;np.random.shuffle(triNR);&amp;#10;" valType="extendedCode"/>
        <Param name="Begin JS Routine" updates="constant" val="tr = triR[k];&amp;#10;tnr = triNR[k];&amp;#10;tt = np.array([tr, tnr]);&amp;#10;console.log(tt);&amp;#10;np.random.shuffle(tt);&amp;#10;tl = tt[0];&amp;#10;console.log(tl);&amp;#10;tid_l = tl[0];&amp;#10;console.log(tid_l);&amp;#10;tl = tl.slice(1);&amp;#10;console.log(tl);&amp;#10;tp = tt[1];&amp;#10;tid_p = tp[0];&amp;#10;tp = tp.slice(1);&amp;#10;tr = tr.slice(1);&amp;#10;trl = np.array_equal(tr, tl);&amp;#10;trp = np.array_equal(tr, tp);&amp;#10;trial_id = ((tid_l + &quot;_&quot;) + tid_p);&amp;#10;console.log(trial_id);&amp;#10;if (eyetracker) {&amp;#10;    io.clearEvents(&quot;all&quot;);&amp;#10;    eyetracker.setRecordingState(true);&amp;#10;    io.sendMessageEvent({&quot;text&quot;: (&quot;%s%s&quot; % [&quot;start:&quot;, trial_id]), &quot;category&quot;: &quot;trial&quot;});&amp;#10;}&amp;#10;" valType="extendedCode"/>
        <Param name="Begin Routine" updates="constant" val="#wez kolejny rozwiazywalny&amp;#10;tr = triR[k]&amp;#10;#wez kolejny nierozwiazywalny&amp;#10;tnr = triNR[k]&amp;#10;#polacz w jeden array&amp;#10;tt = np.array([tr, tnr])&amp;#10;print(tt)&amp;#10;#pomieszaj kolejnosc&amp;#10;np.random.shuffle(tt)&amp;#10;&amp;#10;#tribond po lewej&amp;#10;tl = tt[0]&amp;#10;print(tl)&amp;#10;#wez numer tribonda do trial ID&amp;#10;tid_l = tl[0]&amp;#10;print(tid_l)&amp;#10;#wyrzuc numer z tribonda do wyswietlenia&amp;#10;tl = tl[1:]&amp;#10;print(tl)&amp;#10;&amp;#10;#tribond po prawej&amp;#10;tp = tt[1]&amp;#10;#wez numer tribonda do trial ID&amp;#10;tid_p = tp[0]&amp;#10;#wyrzuc numer z tribonda do wyswietlenia&amp;#10;tp = tp[1:]&amp;#10;&amp;#10;#wyrzuc numer z tribonda&amp;#10;tr = tr[1:]&amp;#10;&amp;#10;#accuracy - sprawdz czy lewy czy prawy jest rozwiazywalny&amp;#10;trl = np.array_equal(tr, tl)&amp;#10;trp = np.array_equal(tr, tp)&amp;#10;&amp;#10;#trial ID&amp;#10;trial_id = tid_l + '_' + tid_p&amp;#10;print(trial_id)&amp;#10;&amp;#10;#ioHub&amp;#10;if eyetracker:&amp;#10;    io.clearEvents('all')&amp;#10;    eyetracker.setRecordingState(True)&amp;#10;    io.sendMessageEvent(text='%s%s' %('start:',trial_id), category = 'trial')&amp;#10;        &amp;#10;#k += 1" valType="extendedCode"/>
        <Param name="Code Type" updates="None" val="Auto-&gt;JS" valType="str"/>
        <Param name="Each Frame" updates="constant" val="" valType="extendedCode"/>
        <Param name="Each JS Frame" updates="constant" val="" valType="extendedCode"/>
        <Param name="End Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="End JS Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="End JS Routine" updates="constant" val="if (np.array_equal(tr, tp)) {&amp;#10;    if ((tri_resp.keys.length === 0)) {&amp;#10;        acc = 9;&amp;#10;    }&amp;#10;    if ((tri_resp.keys === &quot;p&quot;)) {&amp;#10;        acc = 1;&amp;#10;    }&amp;#10;    if ((tri_resp.keys === &quot;q&quot;)) {&amp;#10;        acc = 0;&amp;#10;    }&amp;#10;}&amp;#10;if (np.array_equal(tr, tl)) {&amp;#10;    if ((tri_resp.keys.length === 0)) {&amp;#10;        acc = 9;&amp;#10;    }&amp;#10;    if ((tri_resp.keys === &quot;q&quot;)) {&amp;#10;        acc = 1;&amp;#10;    }&amp;#10;    if ((tri_resp.keys === &quot;p&quot;)) {&amp;#10;        acc = 0;&amp;#10;    }&amp;#10;}&amp;#10;thisExp.addData(&quot;trial_id&quot;, trial_id);&amp;#10;thisExp.addData(&quot;tr&quot;, tr);&amp;#10;thisExp.addData(&quot;tnr&quot;, tnr);&amp;#10;thisExp.addData(&quot;tl&quot;, tl);&amp;#10;thisExp.addData(&quot;tp&quot;, tp);&amp;#10;thisExp.addData(&quot;trp&quot;, trp);&amp;#10;thisExp.addData(&quot;trl&quot;, trl);&amp;#10;thisExp.addData(&quot;acc&quot;, acc);&amp;#10;if (eyetracker) {&amp;#10;    eyetracker.setRecordingState(false);&amp;#10;    io.sendMessageEvent({&quot;text&quot;: (&quot;%s%s&quot; % [&quot;end:&quot;, trial_id]), &quot;category&quot;: &quot;trial&quot;});&amp;#10;}&amp;#10;" valType="extendedCode"/>
        <Param name="End Routine" updates="constant" val="if np.array_equal(tr, tp):&amp;#10;    if len(tri_resp.keys) == 0:&amp;#10;        acc = 9&amp;#10;    if tri_resp.keys == 'p': &amp;#10;        acc = 1&amp;#10;    if tri_resp.keys == 'q':&amp;#10;        acc = 0&amp;#10;&amp;#10;if np.array_equal(tr, tl):&amp;#10;    if len(tri_resp.keys) == 0:&amp;#10;        acc = 9&amp;#10;    if tri_resp.keys == 'q': &amp;#10;        acc = 1&amp;#10;    if tri_resp.keys == 'p':&amp;#10;        acc = 0&amp;#10;&amp;#10;thisExp.addData('trial_id', trial_id)&amp;#10;thisExp.addData('tr', tr)&amp;#10;thisExp.addData('tnr', tnr)&amp;#10;thisExp.addData('tl', tl)&amp;#10;thisExp.addData('tp', tp)&amp;#10;thisExp.addData('trp', trp)&amp;#10;thisExp.addData('trl', trl)&amp;#10;thisExp.addData('acc', acc)&amp;#10;&amp;#10;# IOHUB&amp;#10;&amp;#10;if eyetracker:&amp;#10;    eyetracker.setRecordingState(False)&amp;#10;    io.sendMessageEvent(text='%s%s' %('end:',trial_id), category = 'trial')&amp;#10;&amp;#10;#io.clearEvents('all')&amp;#10;#tracker.setRecordingState(False)&amp;#10;#io.sendMessageEvent(trialID, category='end')" valType="extendedCode"/>
        <Param name="disabled" updates="None" val="False" valType="bool"/>
        <Param name="name" updates="None" val="code_trial" valType="code"/>
      </CodeComponent>
      <TextComponent name="text">
        <Param name="color" updates="constant" val="black" valType="color"/>
        <Param name="colorSpace" updates="constant" val="rgb" valType="str"/>
        <Param name="contrast" updates="constant" val="1" valType="num"/>
        <Param name="disabled" updates="None" val="False" valType="bool"/>
