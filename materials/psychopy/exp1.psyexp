        <Param name="Begin JS Routine" updates="constant" val="/* Syntax Error: Fix Python code */" valType="extendedCode"/>
        <Param name="Begin Routine" updates="constant" val="&amp;#10;ave_error = r['SUMMARY']['AVE_ERROR']&amp;#10;valid_calib_points = r['SUMMARY']['VALID_POINTS']&amp;#10;&amp;#10;calib_query = &quot;Average error is: %f\n\nValid points: %d\n\nRecalibrate (y/n)?&quot; % (ave_error,valid_calib_points)" valType="extendedCode"/>
