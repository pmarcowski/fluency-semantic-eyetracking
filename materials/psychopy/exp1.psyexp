        <Param name="Begin Experiment" updates="constant" val="# using something reasonable as a timeout actually makes more sense&amp;#10;timeout = 10&amp;#10;&amp;#10;ave_error = 0.0&amp;#10;valid_calib_points = 0&amp;#10;&amp;#10;calib_query = &quot;Recalibrate (y/n)?&quot;" valType="extendedCode"/>
