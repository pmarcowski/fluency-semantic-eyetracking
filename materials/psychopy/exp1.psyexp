    <Routine name="training1">
      <CodeComponent name="code_prep">
        <Param name="Before Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="Before JS Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="Begin Experiment" updates="constant" val="import numpy as np&amp;#10;import time&amp;#10;&amp;#10;def get_time():&amp;#10;    return time.strftime('%Y-%m-%d_%H-%M-%S', time.localtime())&amp;#10;&amp;#10;prep_trir = np.array([[&quot;piłka&quot;,&quot;gruszka&quot;,&quot;worek&quot;],[&quot;medalion&quot;,&quot;sznycel&quot;,&quot;stek&quot;], [&quot;kazuar&quot;,&quot;emu&quot;,&quot;nandu&quot;]]) &amp;#10;np.random.shuffle(prep_trir)&amp;#10;prep_trinier = np.array([[&quot;mecz&quot;,&quot;stół&quot;,&quot;grabie&quot;],[&quot;król&quot;,&quot;proszek&quot;,&quot;nowicjusz&quot;], [&quot;paw&quot;,&quot;zakupy&quot;,&quot;płytka&quot;]]) &amp;#10;np.random.shuffle(prep_trinier)&amp;#10;&amp;#10;kprep = 0" valType="extendedCode"/>
        <Param name="Begin JS Experiment" updates="constant" val="import * as np from 'numpy';&amp;#10;import * as time from 'time';&amp;#10;var kprep, prep_trinier, prep_trir;&amp;#10;function get_time() {&amp;#10;    return time.strftime(&quot;%Y-%m-%d_%H-%M-%S&quot;, time.localtime());&amp;#10;}&amp;#10;prep_trir = np.array([[&quot;pi\u0142ka&quot;, &quot;gruszka&quot;, &quot;worek&quot;], [&quot;medalion&quot;, &quot;sznycel&quot;, &quot;stek&quot;], [&quot;kazuar&quot;, &quot;emu&quot;, &quot;nandu&quot;]]);&amp;#10;np.random.shuffle(prep_trir);&amp;#10;prep_trinier = np.array([[&quot;mecz&quot;, &quot;st\u00f3\u0142&quot;, &quot;grabie&quot;], [&quot;kr\u00f3l&quot;, &quot;proszek&quot;, &quot;nowicjusz&quot;], [&quot;paw&quot;, &quot;zakupy&quot;, &quot;p\u0142ytka&quot;]]);&amp;#10;np.random.shuffle(prep_trinier);&amp;#10;kprep = 0;&amp;#10;" valType="extendedCode"/>
        <Param name="Begin JS Routine" updates="constant" val="prep_tr = prep_trir[kprep];&amp;#10;prep_tnr = prep_trinier[kprep];&amp;#10;prep_tt = np.array([prep_tr, prep_tnr]);&amp;#10;console.log(prep_tt);&amp;#10;np.random.shuffle(prep_tt);&amp;#10;prep_tl = prep_tt[0];&amp;#10;console.log(prep_tl);&amp;#10;np.random.shuffle(prep_tl);&amp;#10;prep_tp = prep_tt[1];&amp;#10;np.random.shuffle(prep_tp);&amp;#10;prep_trl = np.array_equal(prep_tr, prep_tl);&amp;#10;prep_trp = np.array_equal(prep_tr, prep_tp);&amp;#10;" valType="extendedCode"/>
        <Param name="Begin Routine" updates="constant" val="#wez kolejny rozwiazywalny&amp;#10;prep_tr = prep_trir[kprep]&amp;#10;#wez kolejny nierozwiazywalny&amp;#10;prep_tnr = prep_trinier[kprep]&amp;#10;#polacz w jeden array&amp;#10;prep_tt = np.array([prep_tr, prep_tnr])&amp;#10;print(prep_tt)&amp;#10;#pomieszaj kolejnosc&amp;#10;np.random.shuffle(prep_tt)&amp;#10;&amp;#10;#tribond po lewej&amp;#10;prep_tl = prep_tt[0]&amp;#10;print(prep_tl)&amp;#10;&amp;#10;#pomieszaj wewnatrz tribonda&amp;#10;np.random.shuffle(prep_tl)&amp;#10;&amp;#10;#tribond po prawej&amp;#10;prep_tp = prep_tt[1]&amp;#10;&amp;#10;#pomieszaj wewnatrz tribonda&amp;#10;np.random.shuffle(prep_tp)&amp;#10;&amp;#10;#accuracy - sprawdz czy lewy czy prawy jest rozwiazywalny&amp;#10;prep_trl = np.array_equal(prep_tr, prep_tl)&amp;#10;prep_trp = np.array_equal(prep_tr, prep_tp)&amp;#10;&amp;#10;&amp;#10;&amp;#10;" valType="extendedCode"/>
        <Param name="Code Type" updates="None" val="Auto-&gt;JS" valType="str"/>
        <Param name="Each Frame" updates="constant" val="" valType="extendedCode"/>
        <Param name="Each JS Frame" updates="constant" val="" valType="extendedCode"/>
