        <Param name="syncScreenRefresh" updates="None" val="True" valType="bool"/>
        <Param name="text" updates="constant" val="W badaniu zobaczysz zestawy par słów, zaprezentowanych jak poniżej. &amp;#10;Twoim zadaniem będzie zidentyfikowanie rozwiązywalnego zestawu i wskazanie go&amp;#10;poprzez wciśnięcie odpowiedniego przycisku: &amp;#10;[q] - jeśli lewy, [p] - jeśli prawy. " valType="str"/>
        <Param name="units" updates="None" val="from exp settings" valType="str"/>
